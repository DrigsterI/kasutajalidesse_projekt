{% extends "base.njk" %}
{% block title %}
  Add Workout
{% endblock %}
{% block head %}
  <script>
    let excerciseTemplate;
    let setTemplate;
    window.onload = function () {
      excerciseTemplate = document.getElementById("exercise-template");
      setTemplate = document.getElementById("set-template");
      const workoutForm = document.querySelector("#workout-form");
      workoutForm.addEventListener('submit', (event) => {
        event.preventDefault();
        saveWorkout();
      });
      const workoutDate = document.querySelector("#workout-date");
      workoutDate.value = new Date().toISOString().split('T')[0];
    };
    function addExercise() {
      const nameInput = document.querySelector("#new_exercise_name");
      let reps = document.getElementById("reps_input");
      let weight = document.getElementById("weight_input");
      if (nameInput.value.trim() !== "") {
        const clone = excerciseTemplate.content.cloneNode(true);
        const excerciseList = document.querySelector("#exercise-list");
        clone.querySelector("legend").textContent = nameInput.value;
        const setClone = getSetTemplate();
        clone.querySelector(".sets-container").appendChild(setClone);
        excerciseList.appendChild(clone);
        nameInput.value = "";
      } else {
        alert("Please enter exercise name");
      }
    }
    function addSet(button) {
      const container = button.closest(".exercise-block").querySelector(".sets-container");
      const setClone = getSetTemplate();
      setClone.querySelector(".set-number").textContent = container.children.length + 1;
      container.appendChild(setClone);
    }
    function recalculateSets(container) {
      const rows = container.querySelectorAll(".set-row");
      rows.forEach((row, index) => {
        row.querySelector(".set-number").textContent = index + 1;
      });
    }
    function removeSet(button) {
      const container = button.closest(".sets-container");
      const row = button.closest(".set-row");
      if (container.querySelectorAll(".set-row").length > 1) {
        row.remove();
        recalculateSets(container);
      } else {
        alert("There should be at least one set per exercise");
      }
    }
    function getSetTemplate() {
      const template = setTemplate.content.cloneNode(true);
      const repsInput = template.querySelector(".set-reps");
      const weightInput = template.querySelector(".set-weight");
      repsInput.addEventListener("input", function (event) {
        event.target.value = event
          .target
          .value
          .replace(/[^0-9]/g, "");
      });
      weightInput.addEventListener("input", function (event) {
        event.target.value = event
          .target
          .value
          .replace(/[^0-9]/g, "");
      });
      return template;
    }
    function saveWorkout() {
      let workout = {};
      workout.name = document.querySelector("#workout-name").value;
      workout.date = document.querySelector("#workout-date").value;
      let exercises = document.querySelectorAll("#exercise-list .exercise-block");
      workout.excercises = [];
      exercises.forEach((exercise) => {
        let exerciseObj = {};
        exerciseObj.name = exercise.querySelector("legend").textContent;
        exerciseObj.sets = [];
        let sets = document.querySelectorAll(".set-row");
        sets.forEach((set) => {
          let setObj = {};
          setObj.reps = set.querySelector(".set-reps").value;
          setObj.weight = set.querySelector(".set-weight").value;
          exerciseObj.sets.push(setObj);
        });
        workout.excercises.push(exerciseObj);
      });
      let workouts = JSON.parse(localStorage.getItem("workouts"));
      workouts.push(workout);
      localStorage.setItem("workouts", JSON.stringify(workouts));
      window.location.href = "workout_history.html";
    }
  </script>
{% endblock %}
{% block nav_title %}New workout{% endblock %}
{% block body %}
  <template id="set-template">
    <div class="set-row">
      <div class="set-header">
        <h3>Set
          <span class="set-number">1</span>
        </h3>
        <button type="button" class="delete-set-btn" onclick="removeSet(this)">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewbox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-trash2-icon lucide-trash-2"><path d="M10 11v6"/><path d="M14 11v6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
          </svg>
        </button>
      </div>
      <div class="input-block">
        <label class="label-group">
          <p>Reps:</p>
          <input class="set-reps" type="text" required="required" placeholder="10"/>
        </label>
        <label class="label-group">
          <p>Weight (kg):</p>
          <input class="set-weight" type="text" required="required" placeholder="30"/>
        </label>
      </div>
    </div>
  </template>
  <template id="exercise-template">
    <fieldset class="block exercise-block">
      <legend>New exercise</legend>
      <div class="sets-container"></div>
      <button type="button" class="exercise-form-btn" onclick="addSet(this)">
        add set
      </button>
    </fieldset>
  </template>
  <form class="workout-grid" action="" method="POST" id="workout-form">
    <div>
      <div class="block main-workout">
        <label class="label-group">
          <p>Workout name:</p>
          <input id="workout-name" type="text" required="required" placeholder="Full Body"/>
        </label>
        <label class="label-group">
          <p>Date:</p>
          <input id="workout-date" type="date" required="required" placeholder="Full Body"/>
        </label>
      </div>
      <fieldset class="block exercise-block ">
        <legend>New exercise</legend>
        <label class="label-group">
          <p>Exercise name:</p>
          <input type="text" id="new_exercise_name" placeholder="Biceps curl"/>
        </label>
        <button class="exercise-form-btn" value="add_exercise" onclick="addExercise()">
          Add exercise
        </button>
      </fieldset>
    </div>
    <div id="exercise-list"></div>
    <button class="exercise-form-btn exercise-save-btn" value="save_workout" type="submit">
      Save
    </button>
  </form>
{% endblock %}